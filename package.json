{
    "name": "scaffold-rollup-lib",
    "version": "1.0.0",
    "author": "jaden.wang  <jaden_wong@icloud.com>",
    "license": "MIT",
    "description": "Simple EventBus class is built for mini programs(Wechat/Alipay) using the publisher/subscriber pattern",
    "type": "module",
    "main": "lib/index.cjs.js",
    "module": "lib/index.esm.js",
    "browser": "lib/index.umd.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.esm.js",
            "require": "./lib/index.cjs.js"
        }
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "dev": "rollup -c -w",
        "clean": "rm -rf ./lib",
        "build": "npm run clean && rollup -c",
        "lint": "eslint ./src",
        "lint:fix": "eslint --fix ./src",
        "prettier": "prettier --config ./.prettierrc --write \"./src/**/*.{json,ts,tsx}\"",
        "prepare": "husky",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "release": "release-it",
        "release:minor": "release-it --increment=minor",
        "release:major": "release-it --increment=major",
        "release:patch": "release-it --increment=patch",
        "commit": "git-cz"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.0.0",
        "@commitlint/config-conventional": "^19.0.0",
        "@release-it/conventional-changelog": "^8.0.0",
        "@rollup/plugin-commonjs": "^26.0.0",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^15.3.0",
        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "^12.1.2",
        "@vitest/coverage-v8": "^3.0.0",
        "jsdom": "^25.0.0",
        "commitizen": "^4.3.1",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-prettier": "^5.2.0",
        "husky": "^9.0.0",
        "lint-staged": "^15.4.0",
        "prettier": "^3.4.0",
        "release-it": "^17.0.0",
        "rollup": "^4.0.0",
        "tslib": "^2.8.0",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.0.0",
        "vitest": "^3.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ljadenwongl/scaffold-rollup-lib.git"
    },
    "config": {
        "commitizen": {
            "path": "node_modules/cz-conventional-changelog"
        }
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    }
}
