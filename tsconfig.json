{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM"],
        "strict": true,
        "declaration": true,
        "declarationDir": "./lib",
        "outDir": "./lib",
        "sourceMap": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "skipLibCheck": true,
        "removeComments": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "lib", "src/**/__tests__/**"]
}
